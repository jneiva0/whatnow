{"nodes": [{"id": "docs_superpowers_specs_2026_10_06_whatnow_web_ui_rituals_design_rituals", "label": "Web morning and evening ritual pages", "file_type": "document", "rationale": "Dedicated stepwise routes reduce morning overwhelm while keeping capture and collapsed chat available. Inline cards preserve distracting context, while a modal would block escape hatches.", "source_file": "docs/superpowers/specs/2026-10-06-whatnow-web-ui-rituals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_06_whatnow_web_ui_rituals_design_triage", "label": "Shared ritual triage and conflict reconciliation", "file_type": "concept", "rationale": "Morning and wrap-up share suggested roll-over, push, and drop choices. A refreshed review preserves surviving choices after conflict; the triage list serves as confirmation because day start and wrap cannot be undone.", "source_file": "docs/superpowers/specs/2026-10-06-whatnow-web-ui-rituals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_06_whatnow_web_ui_rituals_design_task_editor", "label": "All tasks and shared task edit sheet", "file_type": "concept", "rationale": "Structured manual creation bypasses cleanup, preserves raw text as read-only when editing, and treats not-before edits separately from pushes so push counts retain their meaning.", "source_file": "docs/superpowers/specs/2026-10-06-whatnow-web-ui-rituals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_10_06_whatnow_web_ui_rituals_design_rituals", "target": "docs_superpowers_specs_2026_10_05_whatnow_web_ui_today_design_today", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-06-what