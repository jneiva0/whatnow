{"nodes": [{"id": "docs_superpowers_specs_2026_10_06_whatnow_reflection_design_reflection", "label": "Separate planner summary and user reflection", "file_type": "document", "rationale": "The planner keeps factual third-person notes while the user receives a short second-person reflection in their assistant's style. Reflection derives only from the summary so both texts share one factual source.", "source_file": "docs/superpowers/specs/2026-10-06-whatnow-reflection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_06_whatnow_reflection_design_lazy_fill", "label": "Process-local reflection lazy fill", "file_type": "rationale", "rationale": "Today backfills wrapped days with summaries but no reflection asynchronously. Per-day exclusion prevents duplicate calls within a process; failed fills wait for process restart to avoid repeated failing model requests on every reload.", "source_file": "docs/superpowers/specs/2026-10-06-whatnow-reflection-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_10_06_whatnow_reflection_design_reflection", "target": "docs_superpowers_specs_2026_10_05_whatnow_design_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-06-whatnow-reflection-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_10_06_whatnow_reflection_design_lazy_fill", "target": "docs_superpowers_specs_2026_10_06_whatnow_reflection_design_reflection", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-06-whatnow-reflection-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_10_06_whatnow_reflection_design_reflection", "target": "docs