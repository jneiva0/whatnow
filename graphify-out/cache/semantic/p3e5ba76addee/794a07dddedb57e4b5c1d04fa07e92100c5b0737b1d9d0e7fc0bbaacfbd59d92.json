{"nodes": [{"id": "docs_superpowers_specs_2026_10_15_whatnow_review_queue_design_review_queue", "label": "Review Queue ticket integration", "file_type": "document", "rationale": "The integration preserves upstream ranking, applies an optional raw minimum score, caps results at fifty, and reuses the generic ticket picker. Raw scores distinguish requested reviews from bot work better than broad score bands.", "source_file": "docs/superpowers/specs/2026-10-15-whatnow-review-queue-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_15_whatnow_review_queue_design_queue_endpoint", "label": "Review Queue GET /api/queue ranked export", "file_type": "concept", "rationale": "The proposed server endpoint loads saved preferences and uses the existing normalization, repository request, loading, and ranking pipeline so dismissals, penalties, estimates, and rereview signals match the queue UI.", "source_file": "docs/superpowers/specs/2026-10-15-whatnow-review-queue-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_15_whatnow_review_queue_design_rereview", "label": "Rereview-aware open-versus-closed deduplication", "file_type": "rationale", "rationale": "A re-request is new work even when an earlier task was done or dropped. Open refs and skips always suppress tickets; closed refs suppress only tickets without Rereview. Pull and Add share the rule, and the flag survives the client round trip.", "source_file": "docs/superpowers/specs/2026-10-15-whatnow-review-queue-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_10_15_whatnow_review_queue_design_review_queue", "target": "docs_superpowers_specs_2026_10_12_whatnow_jira_design_ticket_flow", "relation": "references"