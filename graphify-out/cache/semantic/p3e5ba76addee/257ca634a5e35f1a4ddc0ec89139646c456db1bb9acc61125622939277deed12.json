{"nodes": [{"id": "docs_superpowers_specs_2026_10_05_whatnow_design_architecture", "label": "whatnow local executive-function assistant architecture", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_facts_and_judgment", "label": "Code establishes facts; the LLM makes judgments", "file_type": "rationale", "rationale": "Deterministic code computes constraints and annotations while the model decides ordering, tiers, pacing, and emotional interpretation. Validation rejects impossibilities rather than filtering away contextual evidence.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_service", "label": "service: sole write path and batch undo", "file_type": "concept", "rationale": "REST handlers and agent tools share writes, activity snapshots, batch assignment, and undo through one service boundary.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_store", "label": "store: SQLite and embedded migrations", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_facts", "label": "facts: pure constraint and annotation functions", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_llm", "label": "llm: Anthropic and OpenAI-compatible provider interface", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_prompt", "label": "prompt: ordered persona and live-context layers", "file_type": "concept", "rationale": "Core instructions precede style, about-me text, and live context to preserve instruction precedence and a cacheable stable prefix. Style affects tone only.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_cleanup", "label": "cleanup: durable capture followed by structured extraction", "file_type": "concept", "rationale": "Raw input is saved before a light-model call, so capture remains usable without a provider. Cleanup applies its changes as one undoable batch and merges only exact ticket-key matches to avoid silently swallowing notes.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_planner", "label": "planner: versioned plans and current-state task picks", "file_type": "concept", "rationale": "Plans remain stable until a defined replan trigger; What now considers all currently eligible tasks. Invalid structured replies get one retry, while provider failure or timeout uses deterministic fallback ordering.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_agent", "label": "agent: serialized streaming chat loop", "file_type": "concept", "rationale": "Only chat uses an open-ended tool loop, capped at ten rounds. A turn shares one undo batch, persists successful earlier writes after later tool failures, and finishes even if its client leaves.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_httpapi", "label": "httpapi: REST and SSE under /api/v1", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_single_binary", "label": "Single Go binary with embedded static SvelteKit frontend", "file_type": "concept", "rationale": "Pure-Go SQLite avoids cgo; embedded frontend assets simplify local distribution. A Homebrew formula supports services and avoids the unsigned-download quarantine behavior described for casks.", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_05_whatnow_design_keychain", "label": "OS keychain for provider secrets", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_10_05_whatnow_design_facts", "target": "docs_superpowers_specs_2026_10_05_whatnow_design_facts_and_judgment", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-10-05-whatnow-design.md", "source_location": null, "we